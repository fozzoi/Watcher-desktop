{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Watcher",
  "version": "3.0.32",
  "identifier": "com.watcher.app",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Watcher",
        "width": 1024,
        "height": 700,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Modern Cinema Companion & Media Discovery",
    "longDescription": "Watcher is a cinematic media discovery application featuring curated catalogs, AI companion, smart stats, and multi-device cloud synchronization.",
    "category": "Video",
    "copyright": "Copyright © 2026 Watcher",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1 | libappindicator3-1"
        ],
        "section": "video",
        "priority": "optional"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFCRDhGQzM0QjIwOEM2ODQKUldTRXhnaXlOUHpZRzl6MWlGRnVIZmdRd01uclJZL0VKU3BpT3dYSHQ1STA1K3djQWwzSHBUdWgK",
      "endpoints": [
        "https://github.com/fozzoi/Watcher-desktop/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
